# Notion API設定
# Notion Integration Tokenを設定してください
# 取得方法: https://www.notion.so/my-integrations
NOTION_API_TOKEN=your_notion_integration_token_here

# Notion Database IDを設定してください
# 取得方法: データベースページのURLから取得
# 例: https://www.notion.so/workspace/{database_id}?v=...
NOTION_DATABASE_ID=your_notion_database_id_here
